				"attributes": [
					{
						"name": "name",
						"string": {
							"computed_optional_required": "required",
							"validators": [
								{
									"custom": {
										"imports": [
											{
												"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
											}
										],
										"schema_definition": "stringvalidator.LengthBetween(3, 40)"
									}
								}
							]
						}
					},
					{
						"name": "region",
						"string": {
							"computed_optional_required": "required",
